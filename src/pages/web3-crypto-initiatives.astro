---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { crypto } from '../data/portfolio';
---

<Base title="Web3/Crypto" description="Investing in crypto and Web3 startups.">
  <div class="w-page page-content">
    <h1 class="pagetitle">Web3/Crypto</h1>
    <h2>Investing in crypto and Web3 startups</h2>
    <div class="spacer" aria-hidden="true"></div>
    <ul>
      <li>
        Co-founder at <a href="https://www.go6ixthevent.com/">6ixth Event</a> investing in crypto and
        Web3 startups
      </li>
    </ul>
    <div class="projects">
      {crypto.map((project) => <ProjectRow project={project} />)}
    </div>
  </div>
</Base>
