---
import Base from '../layouts/Base.astro';
import FeatureRow from '../components/FeatureRow.astro';
import { site } from '../data/site';
import { featured } from '../data/portfolio';
---

<Base>
  <div class="band">
    <h2><strong>{site.description}</strong></h2>
  </div>

  <div class="w-page features">
    <p>
      I have active investments in startups working in technology, based on, and developed
      through, wise, creative, and plain solutions. I am currently investing across multiple
      markets and am interested in companies using lean startup methods and bootstrapping to
      create value.
    </p>

    {featured.map((project, i) => <FeatureRow project={project} reverse={i % 2 === 0} />)}
  </div>
</Base>
