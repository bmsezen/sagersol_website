---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { investments } from '../data/portfolio';
---

<Base title="Angel Investments" description="Helping startups tackling problems in healthcare, education, technology.">
  <div class="w-page page-content">
    <h1 class="pagetitle">Angel Investments</h1>
    <h2>Helping startups tackling problems in healthcare, education, technology</h2>
    <div class="projects">
      {investments.map((project) => <ProjectRow project={project} />)}
    </div>
  </div>
</Base>
