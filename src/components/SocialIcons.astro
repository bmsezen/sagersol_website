---
import { site } from '../data/site';
---

<div id="socialicons">
  <a href={site.social.twitter} class="icon" target="_blank" rel="noopener" aria-label="Twitter">
    <img src="/images/social/twitter-dark.svg" alt="" width="24" height="24" />
  </a>
  <a href={site.social.linkedin} class="icon" target="_blank" rel="noopener" aria-label="LinkedIn">
    <img src="/images/social/linkedin-dark.svg" alt="" width="24" height="24" />
  </a>
</div>
