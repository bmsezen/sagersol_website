---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<ul class="project">
  <li class="project-logo">
    <a href={project.url} target="_blank" rel="noopener">
      <img src={project.logo} alt={`${project.name} logo`} loading="lazy" />
    </a>
  </li>
  <li class="project-body">
    <a href={project.url} target="_blank" rel="noopener"><h3>{project.name}</h3></a>
    {project.location && <p class="small-text">{project.location}</p>}
    {project.description && <p class="pt-1">{project.description}</p>}
  </li>
</ul>
