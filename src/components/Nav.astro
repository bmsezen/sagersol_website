---
import { nav } from '../data/site';

interface Props {
  id?: string;
}
const { id } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<ul id={id} class="menu">
  {
    nav.map((item) => (
      <li>
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))
  }
</ul>
